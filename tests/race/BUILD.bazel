load("@rules_cc//cc:cc_test.bzl", "cc_test")

# CR-053: a Watch stream's replay is never overtaken by a newer message (real gRPC, real shards).
cc_test(
    name = "replay_order_test",
    # Up to two 120 s budgets on a slow host (the traffic bound, not a stream count).
    size = "large",
    srcs = ["replay_order_test.cc"],
    copts = ["-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter", "-Wno-deprecated-declarations"],
    deps = [
        "//src/server",
        "@googletest//:gtest_main",
        "@grpc//:grpc++",
    ],
)
