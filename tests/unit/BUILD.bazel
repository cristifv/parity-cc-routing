load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_test(
    name = "tenant_test",
    size = "medium",
    srcs = ["tenant_test.cc", "world.h"],
    copts = ["-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter"],
    deps = [
        "//src/core",
        "@googletest//:gtest_main",
    ],
)

# CR-052: the masking port passes parity-contracts' cross-language cases.
cc_test(
    name = "pii_test",
    size = "small",
    srcs = ["pii_test.cc"],
    args = ["$(rootpath @parity_contracts//:masking_cases)"],
    copts = ["-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter"],
    data = ["@parity_contracts//:masking_cases"],
    deps = [
        "//src/ops",
        "@googletest//:gtest",
        "@nlohmann_json//:json",
    ],
)

