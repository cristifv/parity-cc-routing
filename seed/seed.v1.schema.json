{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.parity.example/parity-cc-routing/seed.v1.json",
  "title": "parity-cc-routing seed.v1 (phases 1-4)",
  "description": "The configuration (PLAN §8): tenants, queues, agents; since phase 4 each tenant's config.routing and config.routing_pin documents (parity-contracts schemas/config/, until admin-console publishes them); since phase 3 direct-offer and callback settings. src/ops/seed.cc enforces the same rules and refuses to start otherwise. Every queue needs max_wait_s and max_wait_action (review M1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenants"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string"},
    "tenants": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "queues", "agents"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "bin": {"type": "string", "description": "Served only by the RE whose --bin matches; absent: every bin"},
        "reject_skip_s": {"type": "integer", "minimum": 0, "maximum": 300},
        "assignment_deadline_s": {"type": "integer", "minimum": 5, "maximum": 300},
        "grace_s": {"type": "integer", "minimum": 1, "maximum": 3600},
        "owner_loss_s": {"type": "integer", "minimum": 10, "maximum": 3600, "description": "CR-083: an IE owner gone this long loses its calls here (default 60)"},
        "direct_max_wait_s": {"type": "integer", "minimum": 5, "maximum": 3600, "description": "Phase 3: a direct offer waits at most this long (default 60)"},
        "direct_max_wait_action": {"type": "object", "required": ["action"], "properties": {"action": {"enum": ["voicemail", "disconnect", "flow_step"]}, "flow_step": {"type": "string"}}},
        "callback_deadline_s": {"type": "integer", "minimum": 10, "maximum": 3600, "description": "Phase 3: RunCallback.deadline_ms = the agent's accept + this (default 120)"},
        "callback_retry_after_s": {"type": "integer", "minimum": 10, "maximum": 86400, "description": "Phase 3: after CUSTOMER_NO_ANSWER (default 900)"},
        "callback_max_attempts": {"type": "integer", "minimum": 1, "maximum": 10, "description": "Phase 3 (default 3)"},
        "routing": {"type": "object", "description": "Phase 4: the tenant's config.routing document (parity-contracts schemas/config/config-routing.v1.json); absent: mode off"},
        "routing_pins": {"type": "array", "items": {"type": "object"}, "description": "Phase 4: config.routing_pin documents (schemas/config/config-routing-pin.v1.json), one per agent"},
        "queues": {"type": "array", "items": {
          "type": "object", "required": ["id", "max_wait_s", "max_wait_action"],
          "properties": {
            "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
            "required_skills": {"type": "array", "items": {"type": "object", "required": ["skill_id"], "properties": {"skill_id": {"type": "string"}, "min_level": {"type": "integer", "minimum": 0, "maximum": 5}}}},
            "priority": {"type": "integer", "minimum": 1, "maximum": 100},
            "offer_timeout_s": {"type": "integer", "minimum": 5, "maximum": 120},
            "wrap_up_limit_s": {"type": "integer", "minimum": 0, "maximum": 3600},
            "sla_s": {"type": "integer", "minimum": 1, "maximum": 3600},
            "escalate_after_s": {"type": "integer", "minimum": 1, "maximum": 86400},
            "max_wait_s": {"type": "integer", "minimum": 1, "maximum": 86400},
            "max_wait_action": {"type": "object", "required": ["action"], "properties": {"action": {"enum": ["disconnect", "voicemail", "queue", "flow_step", "callback_offer"]}, "queue_id": {"type": "string"}, "flow_step": {"type": "string"}}},
            "max_entries": {"type": "integer", "minimum": 1, "maximum": 100000},
            "aht_s": {"type": "integer", "minimum": 1, "maximum": 7200}
          }}},
        "agents": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "queues"],
          "properties": {
            "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
            "contact": {"type": "string"},
            "skills": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}},
            "queues": {"type": "array", "items": {"type": "string"}}
          }}}
      }}}
  }
}
