load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

# re.state's records (PLAN §5.5, phase 6): a contract between releases (buf breaking in scripts/ci.sh
# against baseline/state.proto).
proto_library(
    name = "state_proto",
    srcs = ["state.proto"],
)

cc_proto_library(
    name = "state_cc_proto",
    deps = [":state_proto"],
)

exports_files(["state.proto"])


# re.state on Redpanda: the transactional group commit and the follower (librdkafka).
cc_library(
    name = "kafka_state",
    srcs = ["kafka_state.cc"],
    hdrs = ["kafka_state.h"],
    copts = ["-Wall", "-Wextra", "-Werror", "-Wno-unused-parameter"],
    deps = [
        ":state_cc_proto",
        "//src/core",
        "//src/ops",
        "@librdkafka",
    ],
)
